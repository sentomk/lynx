{
  "domains": [
    {
      "domain": "Tree",
      "types": [
        {
          "id": "NodeId",
          "type": "integer"
        },
        {
          "id": "Kind",
          "type": "string",
          "enum": [
            "leaf",
            "branch",
            "first-line"
          ]
        },
        {
          "id": "Quad",
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        {
          "id": "Attributes",
          "type": "object"
        },
        {
          "id": "Node",
          "type": "object",
          "properties": [
            {
              "name": "nodeId",
              "$ref": "NodeId"
            },
            {
              "name": "kind",
              "$ref": "Kind"
            },
            {
              "name": "children",
              "type": "array",
              "optional": true,
              "items": {
                "$ref": "Node"
              }
            },
            {
              "name": "parent",
              "$ref": "Node",
              "optional": true
            },
            {
              "name": "attributes",
              "$ref": "Attributes",
              "optional": true
            },
            {
              "name": "box",
              "$ref": "Quad",
              "optional": true
            },
            {
              "name": "owner",
              "$ref": "Other.Owner",
              "optional": true
            }
          ]
        }
      ],
      "commands": [
        {
          "name": "getNode",
          "parameters": [
            {
              "name": "nodeId",
              "$ref": "NodeId"
            }
          ],
          "returns": [
            {
              "name": "node",
              "$ref": "Node"
            }
          ]
        },
        {
          "name": "describe",
          "parameters": [
            {
              "name": "depth",
              "type": "integer",
              "optional": true
            }
          ],
          "returns": [
            {
              "name": "text",
              "type": "string"
            }
          ]
        }
      ],
      "events": [
        {
          "name": "nodeChanged",
          "parameters": [
            {
              "name": "node",
              "$ref": "Node"
            }
          ]
        },
        {
          "name": "nodeRemoved",
          "parameters": [
            {
              "name": "nodeId",
              "$ref": "NodeId"
            }
          ]
        }
      ]
    },
    {
      "domain": "Other",
      "types": [
        {
          "id": "Owner",
          "type": "object",
          "properties": [
            {
              "name": "name",
              "type": "string"
            },
            {
              "name": "root",
              "$ref": "Tree.Node",
              "optional": true
            }
          ]
        }
      ],
      "commands": [],
      "events": []
    }
  ]
}
